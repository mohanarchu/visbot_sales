[Unit]
Description=Visbot website (port 9000)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/var/www/visbot/server
ExecStart=/usr/bin/node bin/website.js
Environment=NODE_ENV=production
Restart=always
RestartSec=3
User=www-data
Group=www-data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=visbot-website

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
