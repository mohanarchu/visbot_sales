# Production environment for the Visbot portal.
# Copy to /var/www/visbot/server/.env on the server, fill in the secrets, then:
#   chown www-data:www-data /var/www/visbot/server/.env
#   chmod 600 /var/www/visbot/server/.env
#
# deploy.sh never overwrites this file.

NODE_ENV=production

# ---- database ----------------------------------------------------------
# Generate a password:  openssl rand -base64 24
DATABASE_URL=postgresql://visbot:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/visbot

# ---- ports (must match the nginx proxy_pass targets) -------------------
WEBSITE_PORT=9000
BACKEND_PORT=9001
ADMIN_PORT=9002

# ---- public addresses --------------------------------------------------
SITE_URL=https://visbot.in
BACKEND_ORIGIN=http://127.0.0.1:9001
# Public address of the backend app — shown as the Meta webhook URL in the admin
BACKEND_PUBLIC_URL=https://backend.visbot.in

# ---- admin login -------------------------------------------------------
# The panel is reachable from the internet. Do NOT keep the local default.
# Generate:  openssl rand -base64 18
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Generate:  openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ---- business ----------------------------------------------------------
WA_NUMBER=918072398966

# ---- Meta lead ads (optional; can also be set in the admin panel) ------
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ID=
# META_PAGE_TOKEN=
# META_VERIFY_TOKEN=
# META_API_VERSION=v22.0
